# ============================================================================
# AC7 Ride — Supabase connection
# ----------------------------------------------------------------------------
# Copy to `.env` and fill in DB_PASSWORD.
#
#   cp .env.supabase.example .env
#
# `.env` is git-ignored. Never commit it, never paste the password into chat.
# ============================================================================

# ---------------------------------------------------------------------------
# READ THIS FIRST
# ---------------------------------------------------------------------------
# Supabase IS PostgreSQL. It is not an alternative to it.
#
# That means:
#   - No Go code changes. The pgx driver connects to Supabase unchanged.
#   - No SQL changes. The same 24 migrations run against it.
#   - The Supabase anon key and the supabase-js SDK are NOT used anywhere in
#     this project. Authentication is handled by the Go `auth` service, which
#     hashes passwords and issues its own JWTs.
#
# Switching from local Docker Postgres to Supabase is the six lines below.
# Nothing else changes.

# ---------------------------------------------------------------------------
# 1. Database — Supabase
# ---------------------------------------------------------------------------
# Find these in: Supabase Dashboard -> Project Settings -> Database
#
# Two connection modes, and the choice matters:
#
#   Direct     db.<ref>.supabase.co:5432        user: postgres
#              Use for MIGRATIONS. golang-migrate needs advisory locks, which
#              the transaction pooler does not support.
#
#   Pooler     aws-0-<region>.pooler.supabase.com:6543   user: postgres.<ref>
#              Use for the RUNNING SERVICES. Seventeen services each opening a
#              connection pool will exhaust direct connections quickly.
#
# The values below are the pooler — correct for running the app.
# Project: A2Dalla17's Project (ref <SUPABASE_PROJECT_REF>, eu-west-2)

DB_HOST=aws-0-eu-west-2.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.<SUPABASE_PROJECT_REF>
DB_PASSWORD=
DB_NAME=postgres

# Mandatory. Supabase refuses unencrypted connections — the default of
# `disable` will fail with a TLS error.
DB_SSLMODE=require

# Keep these low. Supabase's free tier allows 60 pooled connections in total,
# and this platform runs 17 services.
DB_MAX_CONNS=8
DB_MIN_CONNS=2

# ---------------------------------------------------------------------------
# 2. Redis and NATS — still needed
# ---------------------------------------------------------------------------
# Supabase provides Postgres only. Caching, rate limiting and the event bus
# still run locally via Docker Compose:
#
#   docker compose -f deploy/docker-compose.yml up -d redis nats

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

NATS_URL=nats://localhost:4222

# ---------------------------------------------------------------------------
# 3. Application
# ---------------------------------------------------------------------------
PORT=8080
ENVIRONMENT=development
VERSION=1.0.0

# Generate a fresh one — do NOT ship the example value:
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=24

CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# 4. Optional integrations
# ---------------------------------------------------------------------------
# The app runs without these; the related features degrade rather than break.

# Server-side Maps key — routing, ETA, traffic. Separate from the browser key
# in frontend/.env.development.local, and this one must stay secret.
GOOGLE_MAPS_API_KEY=

STRIPE_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

COMMISSION_RATE=0.20
CANCELLATION_FEE_RATE=0.10

RATE_LIMIT_ENABLED=true
