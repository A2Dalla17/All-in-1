# =============================================================================
# AC7 Ride — auth service, standalone image
# -----------------------------------------------------------------------------
# The main Dockerfile builds any service via SERVICE_NAME. This one is fixed to
# `auth` so hosts that expect a plain `docker build .` (Fly, Render, Railway)
# work without extra configuration.
#
#   docker build -f Dockerfile.auth -t ac7-auth .
#
# Final image is ~15 MB: a static binary on Alpine, no Go toolchain shipped.
# =============================================================================

FROM golang:1.24-alpine AS builder

RUN apk add --no-cache git ca-certificates

WORKDIR /build

# The go.mod replace directive points at ./third_party, so that must be present
# before `go mod download` can resolve the module graph.
COPY go.mod go.sum ./
COPY third_party ./third_party
RUN go mod download

COPY . .

# CGO off produces a fully static binary, which is what lets the final stage be
# Alpine rather than a full distro. -s -w strips debug info (~30% smaller).
RUN CGO_ENABLED=0 GOOS=linux go build \
      -ldflags="-s -w" \
      -o /out/auth \
      ./cmd/auth

# -----------------------------------------------------------------------------

FROM alpine:3.20

# TLS roots are required — Supabase refuses unencrypted connections, and
# without these the driver fails with a certificate error.
RUN apk add --no-cache ca-certificates tzdata wget

RUN addgroup -S ac7 && adduser -S ac7 -G ac7

WORKDIR /app
COPY --from=builder /out/auth ./auth

# The JWT key manager writes to config/jwt_keys.json relative to the working
# directory, so that path must exist and be writable by the runtime user.
RUN mkdir -p /app/config && chown -R ac7:ac7 /app

USER ac7

ENV PORT=8080 \
    ENVIRONMENT=production \
    GIN_MODE=release

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:8080/healthz || exit 1

CMD ["./auth"]
