# ACT — environment template
#
# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so never put a real key in here.
#
#   cp .env.example .env.local
#
# Anything named VITE_* is compiled into the JavaScript bundle and is readable
# by anyone who opens the site. That is fine for the values below — they are
# all designed to be public — but it means a secret must never be given a
# VITE_ prefix. Service-role keys, database passwords and unrestricted API
# keys belong on a server, never here.

# ─── Supabase ────────────────────────────────────────────────────────────────
# The anon key is meant to be public; row-level security is what protects the
# data. The service-role key is not, and must never appear in this file.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Google Maps Platform ────────────────────────────────────────────────────
# Powers address autocomplete, geocoding and route/ETA. The map itself renders
# with Leaflet on OpenStreetMap tiles and needs no key at all — see
# docs/GOOGLE-MAPS-SETUP.md for why that split saves the free tier.
#
# Leave this blank and everything still works: address search falls back to
# OpenStreetMap. Nothing breaks without a key.
#
# This key WILL be visible in the bundle. That is expected for a browser key
# and is why the setup guide has you restrict it by HTTP referrer, restrict it
# to only these three APIs, and cap its daily quota. The quota cap is the part
# that actually bounds your bill.
VITE_GOOGLE_PLACES_KEY=

# Self-imposed monthly ceiling per Google SKU. Google gives 10,000 free calls
# per Essentials SKU per month and they do NOT pool across APIs. The default
# leaves roughly 15% headroom because this counter lives in each visitor's
# browser and cannot see the true global total.
#
# This is a cost optimisation, not a guarantee. The guarantee is the daily
# quota cap you set in Cloud Console.
VITE_GOOGLE_MAPS_MONTHLY_BUDGET=8500

# Optional. Set this to a server endpoint (a Supabase Edge Function) that holds
# the Google key server-side and forwards requests. When set, no key is sent
# from the browser at all and VITE_GOOGLE_PLACES_KEY can be left empty.
#
# This is the upgrade path for when volume makes an exposed browser key too
# expensive to leave open. The client already routes every Google call through
# it, so switching is this one variable and no code change.
VITE_GOOGLE_MAPS_PROXY_URL=

# Unused while the map is on OpenStreetMap. Only needed if you ever move the
# map itself to the Maps JavaScript API — which bills per map load, so read the
# cost note in docs/GOOGLE-MAPS-SETUP.md first.
VITE_GOOGLE_MAPS_BROWSER_KEY=

# ─── Where the map opens ─────────────────────────────────────────────────────
# Charing Cross — the point all distances from London are measured from.
VITE_DEFAULT_MAP_LAT=51.5074
VITE_DEFAULT_MAP_LNG=-0.1278
VITE_DEFAULT_MAP_ZOOM=13

# ─── Control centre ──────────────────────────────────────────────────────────
VITE_CONTROL_CENTRE_TEL=+447833172989
VITE_CONTROL_CENTRE_DISPLAY=+44 7833 172989
VITE_CONTROL_CENTRE_EMAIL=support@ac7group.co.uk
VITE_CONTROL_CENTRE_HOURS=Open 24 hours, every day

# ─── Locale ──────────────────────────────────────────────────────────────────
VITE_DEFAULT_CURRENCY=GBP
VITE_LOCALE=en-GB
VITE_PHONE_PREFIX=+44

# ─── Optional ────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
VITE_PREVIEW_MODE=false
