{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,

    /* google.maps was here for the taxi map, which this site no longer has.
       AC7 GALEYR delivers to a district and a landmark, not to a pin — so the
       website needs no map at all, which also keeps it light on a weak
       connection and off the Maps bill entirely. */
    "types": ["vite/client"]
  },
  "exclude": ["node_modules", "dist"]
}
